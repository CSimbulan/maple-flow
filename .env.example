# MongoDB Atlas connection string (Atlas > Connect > Drivers). Include the database name.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/maple-flow?retryWrites=true&w=majority"

# Auth.js secret. Generate one with: npx auth secret   (or any 32+ random bytes, base64)
AUTH_SECRET=""

# OAuth apps (optional; a provider is shown only when both values are set).
# GitHub callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Google callback URL: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email-only sign-in for local development. Ignored when NODE_ENV=production.
AUTH_DEV_LOGIN="true"
