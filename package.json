{
  "name": "maple-flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:memory": "tsx scripts/dev-memory.mts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "schema:print": "tsx scripts/print-schema.mts",
    "codegen": "npm run schema:print && graphql-codegen",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@apollo/client": "^4.3.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.6.0",
    "@mui/material": "^9.6.0",
    "@mui/material-nextjs": "^9.6.0",
    "@pothos/core": "^4.18.1",
    "dataloader": "^2.2.3",
    "fractional-indexing": "^4.0.0",
    "graphql": "^16.15.0",
    "graphql-yoga": "^6.1.1",
    "mongoose": "^9.13.1",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
